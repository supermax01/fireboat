{
  "name": "@fireboat/gateway",
  "mcpName": "io.github.supermax01/fireboat",
  "version": "0.2.0-alpha.1",
  "private": true,
  "description": "Synthetic-only read-only FHIR MCP gateway prototype",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "fireboat": "dist/packages/server/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/stage-runtime-assets.mjs && node scripts/generate-release-metadata.mjs",
    "postbuild": "node scripts/check-dist-identity.mjs && node --import tsx scripts/quickstart/check-helper-boundary.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "tsx packages/server/src/cli.ts",
    "demo": "tsx examples/demo.ts",
    "demo:source": "tsx examples/synthetic-server.ts",
    "doctor": "tsx packages/server/src/cli.ts --doctor --config examples/local.config.json",
    "test:hapi": "tsx scripts/test-hapi.ts",
    "test:medplum": "tsx scripts/test-medplum.ts",
    "eval:retrieval": "tsx packages/evals/src/cli.ts",
    "mutation:guards": "node scripts/mutation-guards.mjs",
    "test:isolation": "node tests/isolation/run.mjs",
    "stage:package": "node --import tsx scripts/stage-package.ts",
    "verify:package": "node --import tsx scripts/verify-package.ts",
    "licenses:release": "node scripts/release-licenses.mjs --check",
    "test:package": "node --import tsx --test tests/package-stage.test.ts tests/package-licenses.test.ts",
    "test:package-installed": "node --import tsx --test tests/package/installed-quickstart.test.ts",
    "release:manifest": "node --import tsx scripts/release-manifest.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.10.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
