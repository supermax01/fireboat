{
 "schema": "fbbench.fuzz-corpus/1",
 "version": "1",
 "label": "adversarial, not natural prevalence",
 "templates": {
  "{{patient}}": "the run patient's id",
  "{{other_patient}}": "another patient of the dataset",
  "{{canary}}": "http://127.0.0.1:<canary port>/fbfuzz-canary/<case id>",
  "{{canary_port}}": "the slot's canary port",
  "{{proxy}}": "the slot's recording proxy base URL",
  "{{case}}": "the case id",
  "{{repeat:<char>:<n>}}": "the character repeated n times"
 },
 "setup_search": {
  "op": "search",
  "type": "Observation",
  "params": [
   [
    "patient",
    "Patient/{{patient}}"
   ]
  ],
  "page_size": 2
 },
