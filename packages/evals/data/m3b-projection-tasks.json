        {
          "kind": "fact",
          "id": "diastolic",
          "step": 2,
          "resource": "obs-bp-1",
          "version": "1",
          "path": "component.1.valueQuantity.value",
          "equals": 76
        },
        {
          "kind": "citationTuple",
          "id": "recovered-citation",
          "step": 2,
          "resource_type": "Observation",
          "id_value": "obs-bp-1",
